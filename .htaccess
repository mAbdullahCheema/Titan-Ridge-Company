# Titan Ridge Company — Apache / LiteSpeed configuration (Namecheap cPanel)
# Upload this file to public_html alongside index.html. Filenames beginning
# with a dot are hidden in File Manager: turn on "Show Hidden Files (dotfiles)".

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

# ---------------------------------------------------------------------------
# Canonical host: always https://titanridgeksa.com (no www)
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS. Namecheap terminates TLS upstream, so check both signals.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://titanridgeksa.com%{REQUEST_URI} [R=301,L]

  # Drop the www. prefix.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Drop trailing slashes from page URLs (never from real directories).
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # -------------------------------------------------------------------------
  # Single-page routes. Only the URLs the site actually has are rewritten to
  # index.html; anything else falls through to a real 404 (see ErrorDocument).
  # -------------------------------------------------------------------------
  RewriteRule ^(expertise|gallery|contact|quote|privacy|terms)$ /index.html [L]
  RewriteRule ^division/(civil|mechanical|electrical|solar|material|orders|manpower|equipment|maintenance|trading)$ /index.html [L]
</IfModule>

# Unknown URLs return HTTP 404 but render the site's own designed 404 page.
ErrorDocument 404 /index.html

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# woff2 and JPEG/PNG are already compressed — do not re-compress them.
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Request_URI \.(?:woff2?|jpe?g|png|ico|gz|zip)$ no-gzip dont-vary
</IfModule>

# ---------------------------------------------------------------------------
# Caching
#
# Asset filenames are NOT content-hashed. If you replace an image, a font or a
# script in place, returning visitors keep the old copy until the max-age below
# expires. To publish a change immediately, upload it under a new filename and
# update the reference in index.html.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/x-icon              "access plus 1 month"
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  # index.html is the app shell — always revalidate so deploys take effect.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(woff2|jpg|jpeg|png|ico|css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # ---------------------------------------------------------------------------
  # Security headers
  #
  # 'unsafe-inline' and 'unsafe-eval' are required: the page is styled with
  # inline style attributes and the design runtime compiles its template with
  # the Function constructor. Everything else is locked to this origin, so no
  # third-party script, font, frame or XHR endpoint can be introduced.
  # ---------------------------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

  # Fonts are same-origin here, but keep CORS open in case a CDN is added later.
  <FilesMatch "\.woff2$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType image/x-icon .ico
</IfModule>

# ---------------------------------------------------------------------------
# Keep working files out of the public web root
# ---------------------------------------------------------------------------
<FilesMatch "^(CLAUDE|DEPLOY|README)\.md$|^\.">
  Require all denied
</FilesMatch>
